# Copy to .env.local (for `vercel dev`) and fill in real values.
# NONE of these should ever be prefixed with VITE_ — that would bundle
# them into the public JS and expose them to every visitor.

# The single passphrase that unlocks edit mode. Pick something long and
# unique — it is the only thing standing between the public and your
# editable content.
OWNER_PASSPHRASE=change-this-to-a-long-passphrase

# Random secret used to sign the owner session cookie. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=change-this-to-a-random-64-char-string

# Added automatically by Vercel when you attach an Upstash Redis database
# (Storage tab -> Marketplace Database Providers -> Upstash). You do not
# need to set these by hand in production — only for local `vercel dev`
# after running `vercel env pull .env.local`.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Added automatically by Vercel when you create a Blob store (Storage tab
# -> Create Database -> Blob) and connect it to this project.
BLOB_READ_WRITE_TOKEN=
